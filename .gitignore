# ─── SSH: config only, never keys or machine state ───────
shell/.ssh/*
!shell/.ssh/config
known_hosts*
id_*
*.pem
*.key

# ─── Machine-local overrides (live in $HOME, never in git) ─
.gitconfig.local
.bashrc.local
.zshrc.local
.tmux.local.conf

# ─── nvim: folded into the repo, so keep runtime junk out ─
nvim/.config/nvim/lua/local.lua
nvim/.config/nvim/parser/
nvim/.config/nvim/spell/
nvim/.config/nvim/lazy-lock.json

# ─── fish writes these itself ────────────────────────────
desktop/.config/fish/fish_variables
desktop/.config/fish/conf.d/
desktop/.config/fish/functions/
desktop/.config/fish/completions/

.dotfiles-backup/
