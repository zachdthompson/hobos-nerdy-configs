#!/usr/bin/env bash
# tssh — cssh-style multi-ssh in tmux. Thin wrapper around xpanes.
#
#   tssh host1 host2 host3          one pane per host, broadcast ON
#   tssh node{1..5}.lab              brace expansion works (bash/zsh; fish too)
#   tssh @cp                         hosts from ~/.config/tssh/groups/cp
#   tssh @cp @workers extra-host     mix groups and hosts
#   tssh -J jumpbox @cp              ProxyJump through a bastion — avoids
#                                    running xpanes ON the jumpbox (nested tmux)
#   tssh -l admin -d host1 host2     remote user, start with broadcast OFF
#
# Inside tmux: opens a new window in the current session.
# Outside tmux: creates a session and attaches.
# Toggle broadcast with prefix+e. Group files: one host per line, # comments.

set -euo pipefail

GROUP_DIR="${TSSH_GROUP_DIR:-$HOME/.config/tssh/groups}"
usage() { sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

jump="" user="" desync=()
while getopts ":J:l:dh" opt; do
    case "$opt" in
        J) jump="$OPTARG" ;;
        l) user="$OPTARG" ;;
        d) desync=(-d) ;;
        h) usage 0 ;;
        :) echo "tssh: -$OPTARG needs a value" >&2; exit 2 ;;
        *) echo "tssh: unknown option -$OPTARG" >&2; usage 2 ;;
    esac
done
shift $((OPTIND - 1))
[ $# -gt 0 ] || usage 2

# ─── Validation ──────────────────────────────────────────
# xpanes types the command into each pane's shell (bash, zsh or fish). Values
# are allow-listed (no quotes, no metacharacters) AND single-quoted when
# inserted, since IPv6 brackets are glob characters in bash/zsh.
USER_RE='[A-Za-z0-9_][A-Za-z0-9._-]*'
NAME_RE='[A-Za-z0-9_][A-Za-z0-9._-]*'                   # hostname / IPv4 / alias
V6_RE='[0-9A-Fa-f]*:[0-9A-Fa-f:.]*(%[A-Za-z0-9._-]+)?'  # ::1, fe80::1%eth0, ::ffff:1.2.3.4
PORT_RE='[0-9]{1,5}'
RE_USER="^${USER_RE}\$"
RE_DEST="^(${USER_RE}@)?(${NAME_RE}|${V6_RE})\$"                                  # ssh [user@]host
RE_URI="^ssh://(${USER_RE}@)?(${NAME_RE}|\[${V6_RE}\])(:${PORT_RE})?\$"           # ssh://[u@]h[:p]
RE_HOP="^(${USER_RE}@)?((${NAME_RE}|\[${V6_RE}\])(:${PORT_RE})?|${V6_RE})\$"     # -J hop
RE_GROUP='^[A-Za-z0-9_][A-Za-z0-9._-]*$'

bad() { echo "tssh: refusing $1: '$2' (expected [user@]host, IPv6, or ssh://[user@]host[:port])" >&2; exit 2; }

[ -z "$user" ] || [[ "$user" =~ $RE_USER ]] || bad "user" "$user"
if [ -n "$jump" ]; then
    IFS=, read -ra hops <<< "$jump"
    [ ${#hops[@]} -gt 0 ] || bad "jump host" "$jump"
    for h in "${hops[@]}"; do
        # ProxyJump hops may carry :port, or be ssh:// URIs
        [[ "$h" =~ $RE_HOP || "$h" =~ $RE_URI ]] || bad "jump host" "$h"
    done
fi

hosts=()
for arg in "$@"; do
    if [[ "$arg" == @* ]]; then
        g="${arg#@}"
        [[ "$g" =~ $RE_GROUP ]] || bad "group name" "$g"
        f="$GROUP_DIR/$g"
        [ -r "$f" ] || { echo "tssh: no group file $f" >&2; exit 1; }
        while IFS= read -r line || [ -n "$line" ]; do
            line="${line%%#*}"
            line="${line#"${line%%[![:space:]]*}"}"; line="${line%"${line##*[![:space:]]}"}"
            [ -z "$line" ] && continue
            [[ "$line" =~ $RE_DEST || "$line" =~ $RE_URI ]] || bad "host in $f" "$line"
            hosts+=("$line")
        done < "$f"
    else
        [[ "$arg" =~ $RE_DEST || "$arg" =~ $RE_URI ]] || bad "host" "$arg"
        hosts+=("$arg")
    fi
done
[ ${#hosts[@]} -gt 0 ] || { echo "tssh: no hosts" >&2; exit 1; }

XPANES="$(command -v xpanes || true)"
[ -n "$XPANES" ] || { echo "tssh: xpanes not found on PATH" >&2; exit 1; }
command -v tmux >/dev/null || { echo "tssh: tmux not installed" >&2; exit 1; }

# Validated values contain no single quotes, so '...' is a plain literal in
# bash, zsh and fish alike. '--' stops ssh reading a destination as an option.
ssh_cmd="ssh"
[ -n "$jump" ] && ssh_cmd+=" -J '$jump'"
[ -n "$user" ] && ssh_cmd+=" -l '$user'"

# -t: hostname as each pane's border title. xpanes enables sync by default.
# Never use xpanes --ssh: it disables StrictHostKeyChecking.
exec "$XPANES" -t ${desync[@]+"${desync[@]}"} -c "$ssh_cmd -- '{}'" "${hosts[@]}"
